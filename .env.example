# Copy to .env.local and fill in values:  cp .env.example .env.local
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser. Never put secrets in them.

# Public origin of the storefront. Used for canonical URLs, Open Graph, sitemap.xml and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Django API base URL. Reserved for the future backend integration phase:
# the storefront does NOT call the API yet (all data comes from src/data).
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
