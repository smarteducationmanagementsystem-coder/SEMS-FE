{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sems-fe",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sems-fe"
    }
  ]
}
